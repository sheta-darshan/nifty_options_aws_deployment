# ===========================
# Dhan API Credentials (Primary Account)
# ===========================
DHAN_API_TOKEN='your_dhan_jwt_token_here'
DHAN_CLIENT_ID=your_client_id_here

# ===========================
# Dhan API Credentials (Second Account - Optional)
# ===========================
DHAN_API_TOKEN_2='your_second_dhan_jwt_token_here'
DHAN_CLIENT_ID_2=your_second_client_id_here

# ===========================
# Trading Configuration
# ===========================
LEG_MODE=BOTH  # Possible values: BUY, SELL, BOTH

# ===========================
# Alerts (Telegram Webhook)
# ===========================
ALERT_WEBHOOK_URL="https://api.telegram.org/bot<YOUR_BOT_TOKEN>/sendMessage?chat_id=<YOUR_CHAT_ID>"

# ===========================
# Network
# ===========================
DHAN_SOURCE_IP=  # Optional: Source IP for AWS deployment

# ===========================
# Feature Flags
# ===========================
USE_DYNAMIC_EXITS=False
CARRY_FORWARD=True
